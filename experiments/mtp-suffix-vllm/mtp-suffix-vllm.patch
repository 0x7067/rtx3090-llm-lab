+        idx_mapping = self.idx_mapping[:num_reqs].to(dtype=torch.long)
+        for step in range(self.num_speculative_steps):
+            req_rows = torch.nonzero(
+                self._lookup_use[:num_reqs, step], as_tuple=False
+            ).flatten()
+            if req_rows.numel() == 0:
+                continue
+            state_rows = idx_mapping[req_rows]
+            step_logits = self.draft_logits[:, step]
+            step_logits.index_fill_(0, state_rows, -float("inf"))
+            step_logits[state_rows, self.draft_tokens[req_rows, step]] = 0.0
