+    def _rewrite_lookup_logits(self, num_reqs: int) -> None:
+        """Make each lookup-owned q row an exact point mass.
+
+        MTP stores dense, temperature-processed logits.  Rewriting only the
+        rows marked by fuse_draft keeps ordinary MTP q untouched while making
+        the probabilistic rejection sampler exact for lookup proposals.
+        """
+        if self.draft_logits is None:
