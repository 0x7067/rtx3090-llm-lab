-+    hkv = k_cache.shape[2]
-+    g = hq // hkv
-+    bs = k_cache.shape[1]
-+    dev = q.device
-+    seqused = torch.tensor([kv_len], dtype=torch.int32, device=dev)
-+    KTILE = block_n
-+    if int8_qk:
-+        n_tiles = triton.cdiv(kv_len, KTILE)
